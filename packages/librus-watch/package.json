{
  "name": "@tomiwu/librus-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches Librus Synergia and reports new Items to the Recipients on Telegram.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./scheduled": "./src/entry/scheduled.ts",
    "./upcoming": "./src/entry/upcoming.ts",
    "./lessons": "./src/entry/lessons.ts",
    "./children": "./src/entry/children.ts",
    "./purge": "./src/entry/purge.ts",
    "./configure": "./src/entry/configure.ts"
  },
  "dependencies": {
    "@automations/librus-data": "*",
    "@automations/shared": "*",
    "cheerio": "1.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "crap": "crap4ts --exclude .test --exclude entry --fail-on-crap 6"
  },
  "kody": {
    "id": "librus-watch",
    "description": "Reports new Librus Items to the Recipients on Telegram.",
    "jobs": {
      "scheduled-check": {
        "entry": "./src/entry/scheduled.ts",
        "schedule": {
          "type": "cron",
          "expression": "0 7,18 * * *"
        }
      },
      "daily-purge": {
        "entry": "./src/entry/purge.ts",
        "schedule": {
          "type": "cron",
          "expression": "30 3 * * *"
        }
      }
    },
    "credentials": {
      "SUPABASE_KEY": {
        "description": "Key of the restricted Supabase role automations_watcher (sent as {{secret:SUPABASE_KEY}} to the Supabase project host)."
      }
    }
  }
}
