{
  "name": "@tomiwu/payments-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds ZBP payment QR codes for the Fees of the Organizers and sends them to the Recipients on Telegram.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./scheduled": "./src/entry/scheduled.ts",
    "./configure": "./src/entry/configure.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "crap": "crap4ts --exclude .test --exclude entry --exclude test-fixtures --fail-on-crap 6"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "@automations/librus-data": "*",
    "@automations/shared": "*",
    "@tomiwu/librus-watch": "*",
    "cheerio": "1.0.0",
    "qrcode": "^1.5.4"
  },
  "kody": {
    "id": "payments-watch",
    "description": "Sends the Fee Payments with a ZBP QR code to the Recipients on Telegram.",
    "jobs": {
      "scheduled-check": {
        "entry": "./src/entry/scheduled.ts",
        "schedule": {
          "type": "cron",
          "expression": "0 8 * * *"
        }
      }
    },
    "credentials": {
      "SUPABASE_KEY": {
        "description": "Key of the restricted Supabase role automations_watcher (sent as {{secret:SUPABASE_KEY}} to the Supabase project host)."
      }
    }
  }
}
