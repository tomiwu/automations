{
  "name": "@tomiwu/kradziejka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Routes an allowlisted Telegram chat to the Grok bot that matches the message.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./telegram-update": "./src/entry/telegram-update.ts",
    "./reply": "./src/entry/reply.ts",
    "./register-bot": "./src/entry/register-bot.ts",
    "./configure": "./src/entry/configure.ts",
    "./app": "./src/entry/app.ts"
  },
  "dependencies": {
    "@automations/shared": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "crap": "crap4ts --exclude .test --exclude entry --fail-on-crap 6"
  },
  "kody": {
    "id": "kradziejka",
    "description": "Routes an allowlisted Telegram chat to the Grok bot that matches the message.",
    "dependencies": {
      "@tomiwu/telegram": "*"
    },
    "credentials": {
      "SUPABASE_KEY": {
        "description": "Key of the restricted Supabase role automations_watcher (sent as {{secret:SUPABASE_KEY}} to the Supabase project host)."
      },
      "JEV_API_KEY": {
        "description": "Jev API key. Kody sends it as Bearer {{secret:JEV_API_KEY}} to api.getjevai.com. Header placement."
      }
    },
    "webhooks": [
      {
        "name": "telegram-update",
        "export": "./telegram-update",
        "responseMode": "ack",
        "verification": { "type": "url-secret" }
      },
      {
        "name": "reply",
        "export": "./reply",
        "responseMode": "sync",
        "inputMode": "params",
        "verification": { "type": "url-secret" }
      },
      {
        "name": "register",
        "export": "./register-bot",
        "responseMode": "sync",
        "inputMode": "params",
        "verification": { "type": "url-secret" }
      }
    ],
    "app": {
      "entry": "./src/entry/app.ts"
    }
  }
}
