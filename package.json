{
  "name": "automations",
  "private": true,
  "type": "module",
  "description": "Generic school and activity watchers that report to Telegram.",
  "license": "MIT",
  "workspaces": ["packages/*", "tools/*"],
  "engines": { "node": ">=22" },
  "scripts": {
