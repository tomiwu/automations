{
  "name": "automations",
  "private": true,
  "type": "module",
  "description": "Generic school and activity watchers that report to Telegram.",
  "license": "MIT",
  "workspaces": ["packages/*", "tools/*", "scripts/sandcastle-loop"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "crap": "npm run crap --workspaces --if-present",
    "test:sql:local": "bash scripts/test-sql-local.sh",
    "check": "bash scripts/check.sh",
    "privacy": "tsx tools/privacy-check/src/cli.ts",
    "privacy:hash": "tsx tools/privacy-check/src/cli.ts hash",
    "clean-publish": "bash scripts/clean-publish.sh",
    "crap:changed": "tsx tools/dev-checks/src/cli.ts",
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "test:loop": "tsx .sandcastle/loop-policy-test.mts && bash scripts/test-stop-gate.sh"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@sebassdc/crap4ts": "^0.1.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
