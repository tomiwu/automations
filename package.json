  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@sebassdc/crap4ts": "^0.1.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
