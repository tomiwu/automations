# Example environment for a local run on Node (docs/running-on-node.md) and for the local checks.
# Copy this file to `.env` (git-ignored) and enter your own values. Never commit a value.

# Storage (key of the role automations_watcher) and the Family of this deployment.
SUPABASE_URL=
SUPABASE_KEY=
FAMILY_ID=

# One variable for each secret NAME in the `accounts` table (see examples/seed.example.json).
CHILD1_LIBRUS_LOGIN=
CHILD1_LIBRUS_PASSWORD=

# Only for Edusky.
EDUSKY_CLIENT_SECRET=

# Privacy gate (tools/privacy-check). The plain private word list is a local file. It is never committed.
DENYLIST_FILE=
PRIVACY_PEPPER=

# SQL tests against a throwaway Postgres (npm run test:sql:local sets it for you).
TEST_DATABASE_URL=
