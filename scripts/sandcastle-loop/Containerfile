# Sandbox image of the shared Sandcastle loop for this repository (automations).
# Build it with scripts/sandcastle-loop/build-image.sh. Repo-specific tools (for example a Rust or C++
# toolchain) stay in the Containerfile of that repository (LOOP_CONTAINERFILE).
FROM node:22-bookworm

# apt over HTTPS with retries and without SRV records. On the box, apt asks DNS for the SRV record
# _http._tcp.deb.debian.org, and that target goes to the proxy 198.18.0.1, which gives HTTP 500 for the
# InRelease files (then apt reports "not signed") and breaks the TLS handshake for https. A plain lookup of
# deb.debian.org (curl does this) works. Step 1 installs ca-certificates over HTTP only when the base
# image does not have them (node:22-bookworm has them); step 2 switches the sources to https.
# The podman store on the box can lose the mode of /tmp, and apt-key then cannot write its temporary file
# (apt also reports that as "not signed"). So each apt step sets /tmp to 1777 first.
RUN install -d -m 1777 /tmp \
  && printf 'Acquire::Retries "5";\nAcquire::EnableSrvRecords "false";\n' > /etc/apt/apt.conf.d/80-loop-net \
  && if [ ! -s /etc/ssl/certs/ca-certificates.crt ]; then \
       apt-get update && apt-get install -y --no-install-recommends ca-certificates; \
     fi \
  && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources

# Install system dependencies
RUN install -d -m 1777 /tmp && apt-get update && apt-get install -y \
  git \
  curl \
  jq \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI
RUN install -d -m 1777 /tmp && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
  && apt-get update && apt-get install -y gh \
  && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI (used when AGENT=claude)
RUN npm install -g @anthropic-ai/claude-code

# Build-args for UID/GID alignment: sandcastle docker build-image
# defaults these to the host user's UID/GID so image-built files
# and bind-mounted files share an owner without runtime chown.
ARG AGENT_UID=1000
ARG AGENT_GID=1000

# Rename the base image's "node" user to "agent" and align UID/GID.
# The podman store on the box can lose the owner of the moved home directory, so set it again here.
RUN groupmod -o -g $AGENT_GID node && usermod -o -u $AGENT_UID -g $AGENT_GID -d /home/agent -m -l agent node \
  && install -d -o $AGENT_UID -g $AGENT_GID /home/agent && chown -R $AGENT_UID:$AGENT_GID /home/agent
USER ${AGENT_UID}:${AGENT_GID}

# Cursor CLI fetches plugins over SSH. The sandbox has no SSH key, so use HTTPS.
RUN git config --global url."https://github.com/".insteadOf "git@github.com:" \
  && git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/"

# Install Cursor Agent CLI
RUN curl https://cursor.com/install -fsS | bash

# Add Cursor CLI to PATH
ENV PATH="/home/agent/.local/bin:$PATH"

# Permission fix: Podman runs with --userns=keep-id, so the runtime UID can differ
# from the build UID. Make the home directory writable for that UID (git config, npm cache).
# These are the last root steps. The podman store can lose owners and modes, so set them here.
USER root
RUN chmod -R a+rwX /home/agent \
  && install -d -m 1777 /tmp \
  && chown -R $AGENT_UID:$AGENT_GID /home/agent

# The build fails when the image is broken: run the container part of the loop doctor as the agent user.
ARG LOOP_MODELS=claude:default,cursor:default
COPY doctor.sh /usr/local/lib/sandcastle-loop/doctor.sh
USER ${AGENT_UID}:${AGENT_GID}
RUN LOOP_MODELS="$LOOP_MODELS" bash /usr/local/lib/sandcastle-loop/doctor.sh container

WORKDIR /home/agent

# In worktree sandbox mode, Sandcastle bind-mounts the git worktree at /home/agent/workspace
# and overrides the working directory to /home/agent/workspace at container start.
ENTRYPOINT ["sleep", "infinity"]
