#!/usr/bin/env bash
# Pre-commit hook: fast checks on the staged changes only. A finding stops the commit.
#   gitleaks   the staged changes, with the flags and the .gitleaksignore of scripts/ci-local.sh (--redact: no secret value)
#   privacy    tools/privacy-check on the staged lines. It prints places and categories, never a value.
#   typecheck  `npm run typecheck` only in the workspaces with a staged file (tools/dev-checks)
# It does not run the tests and it uses no network. Install it with: scripts/install-hooks.sh
# Do not use `git commit --no-verify` for this hook.
#   GITLEAKS  gitleaks binary (default: gitleaks in PATH, else the cache of scripts/install-hooks.sh)
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TSX="$HERE/node_modules/.bin/tsx"
cd "$(git rev-parse --show-toplevel)" || exit 1

find_gitleaks() {
  local bin="${GITLEAKS:-}"
  [ -n "$bin" ] || bin="$(command -v gitleaks)" || bin="${XDG_CACHE_HOME:-${HOME:-}/.cache}/ci-local/gitleaks"
  [ -x "$bin" ] && printf '%s\n' "$bin"
}

gitleaks_staged() {
  local bin
  bin="$(find_gitleaks)" || { echo "pre-commit: gitleaks is not installed. Run scripts/install-hooks.sh" >&2; return 1; }
  "$bin" git --pre-commit --staged --redact --verbose --no-banner --exit-code 1 .
}

FAILED=""
step() {
  local name="$1"; shift
  "$@" || { echo "pre-commit: FAILED $name" >&2; FAILED="$FAILED $name"; }
}

step gitleaks gitleaks_staged
step privacy "$TSX" "$HERE/tools/privacy-check/src/cli.ts" --staged
step typecheck "$TSX" "$HERE/tools/dev-checks/src/cli.ts" --staged --script typecheck
if [ -n "$FAILED" ]; then
  echo "pre-commit: the commit was stopped by:$FAILED. Correct the findings. --no-verify is not allowed." >&2
  exit 1
fi
